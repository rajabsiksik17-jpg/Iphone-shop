# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public origin of the store (used for canonical URLs, sitemaps, emails, OAuth/payment callbacks).
APP_URL=https://shop.example.com

# ─── Database ───────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ instance. For local dev `npm run db:start` launches an
# embedded PostgreSQL on EMBEDDED_DB_PORT using the URL below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/nuqta
EMBEDDED_DB_PORT=5433
# Supabase (see docs/SUPABASE.md):
#   DATABASE_URL = Transaction pooler, port 6543 (used by the running app)
#   DIRECT_URL   = Direct / session connection, port 5432 (used by migrations)
# DIRECT_URL=

# ─── Secrets ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_SECRET    — HMAC pepper for session tokens, OTP codes, reset tokens.
# ENCRYPTION_KEY — AES-256-GCM key for secrets stored in the DB (gateway keys,
#                  SMTP password…). Rotating it makes stored secrets unreadable.
APP_SECRET=
ENCRYPTION_KEY=

# ─── Storage ────────────────────────────────────────────────────────────────
# "local" stores uploads on disk under STORAGE_DIR (must be persistent).
# "supabase" stores them in a Supabase Storage bucket (recommended for hosting).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Required when STORAGE_DRIVER=supabase. SERVER-ONLY: never rename these with a
# NEXT_PUBLIC_ prefix — the service-role key bypasses all database security.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media

# ─── Optional ───────────────────────────────────────────────────────────────
# Trust X-Forwarded-For / proxy country headers (set when behind a reverse proxy/CDN).
TRUST_PROXY=false
# Comma-separated extra origins allowed to open the realtime socket.
# REALTIME_ALLOWED_ORIGINS=

# ─── Seeding ───────────────────────────────────────────────────────────────
# First super-admin created by `npm run db:seed` when no staff exist.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Set to false in production to seed essentials only (no demo catalogue/orders).
SEED_DEMO=false
